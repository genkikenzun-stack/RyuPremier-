-- Safe Proximity Check Execution Loop
RunService.Heartbeat:Connect(function()
    if not autoParryActive or not manualVerified or not parryRemote then return end
    
    if isBallTargetingMe() then
        local currentTime = tick()
        local randomDelay = math.random(65, 85) / 1000 
        
        if currentTime - lastParryTime >= randomDelay then
            lastParryTime = currentTime
            local args = buildParryArgs()
            if args then 
                parryRemote:FireServer(unpack(args)) 
            end
        end
    end
end)
                                
