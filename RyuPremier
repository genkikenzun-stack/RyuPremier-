-- Delta Safe Remote Fetcher
local parryRemote = nil
local function fetchRemote()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if packages then
        for _, v in ipairs(packages:GetDescendants()) do
            if v:IsA("RemoteEvent") and (v.Name:sub(1,3) == "RE/" or v.Name:find("Parry")) then
                parryRemote = v
                break
            end
        end
    end
    if not parryRemote then
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name:find("Parry") then
                parryRemote = v
                break
            end
        end
    end
end
fetchRemote()

local function buildParryArgs()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local vp = camera.ViewportSize
    return { camera.CFrame, {vp.X / 2, vp.Y / 2}, false }
end

-- Check if ball targets player
local function isBallTargetingMe()
    local ballsFolder = workspace:FindFirstChild("Balls")
    if not ballsFolder then return false end

    for _, ball in ipairs(ballsFolder:GetChildren()) do
        if ball:GetAttribute("realBall") == true or ball.Name == "Ball" then
            if ball:GetAttribute("target") == LocalPlayer.Name then
                return true
            end
        end
    end
    return false
end

