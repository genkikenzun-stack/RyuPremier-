-- Lightweight Asset Optimizer
local function optimizeAsset(instance)
    if instance:IsA("Part") or instance:IsA("MeshPart") or instance:IsA("BasePart") then
        instance.Material = Enum.Material.SmoothPlastic
        instance.Reflectance = 0
        instance.CastShadow = false
    elseif instance:IsA("Decal") or instance:IsA("Texture") then
        instance:Destroy()
    elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") then
        instance.Enabled = false
    elseif instance:IsA("BlurEffect") or instance:IsA("SunRaysEffect") or instance:IsA("BloomEffect") then
        if instance.Name ~= "MotionBlur" then
            instance.Enabled = false
        end
    end
end

local optimizeConnection = nil
local function runFPSBooster(state)
    if state then
        Lighting.GlobalShadows = false
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then terrain.Decoration = false end
        for _, obj in pairs(workspace:GetDescendants()) do
            optimizeAsset(obj)
        end
        optimizeConnection = workspace.DescendantAdded:Connect(function(obj)
            task.wait()
            optimizeAsset(obj)
        end)
    else
        if optimizeConnection then
            optimizeConnection:Disconnect()
            optimizeConnection = nil
        end
    end
end

-- Reusable Lite Button Maker
local function makeToggle(text, yPos, callback)
    local btn = Instance.new("TextButton", main)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 52)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    local active = false
    local function updateVisuals()
        if active then
            btn.Text = text .. ": ON"
            btn.TextColor3 = Color3.fromRGB(120, 255, 120)
            btn.BackgroundColor3 = Color3.fromRGB(55, 65, 55)
        else
            btn.Text = text .. ": OFF"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 52)
        end
    end
    
    updateVisuals()
    btn.MouseButton1Click:Connect(function()
        active = not active
        updateVisuals()
        callback(active)
    end)
end

